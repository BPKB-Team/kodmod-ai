# Caddy obtains and renews HTTPS certificates for APP_DOMAIN automatically.
{
	email {$ACME_EMAIL}
}

{$APP_DOMAIN} {
	encode zstd gzip
	header {
		Strict-Transport-Security "max-age=31536000"
		X-Content-Type-Options nosniff
		X-Frame-Options DENY
		Referrer-Policy no-referrer
		-Server
	}
	# Prometheus scrapes the internal API directly.
	@privateMetrics path /metrics /api/metrics
	handle @privateMetrics {
		respond 404
	}

	# The existing authenticated FastAPI WebSocket transport is kept available.
	@websocket path /ws/*
	handle @websocket {
		reverse_proxy ai-engine:8000
	}

	# Cookie authentication and server-side API proxies belong to Next.js.
	handle {
		reverse_proxy web:3000
	}
}
