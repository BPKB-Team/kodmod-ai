# KODMOD AI - Example environment file.
# Copy to `.env` and fill in real values for your deployment.

# ----------- runtime
ENV=dev
DEBUG=true
LOG_LEVEL=INFO
LOG_JSON=false

# ----------- API
API_HOST=127.0.0.1
API_PORT=8109
# Comma-separated. Must list the frontend origin explicitly: credentials are
# allowed, so "*" is not a valid value.
CORS_ALLOW_ORIGINS=http://localhost:3100,http://127.0.0.1:3100
JWT_SECRET=change-me-to-a-32+-byte-secret
JWT_ALG=HS256
JWT_EXPIRE_MIN=1440

# ----------- database (host port 5433 maps to container port 5432)
DB_USER=kodmod
DB_PASSWORD=kodmod
DB_HOST=localhost
DB_PORT=5433
DB_NAME=kodmod

# ----------- redis
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0
# REDIS_PASSWORD=

# ----------- llm (OpenAI only)
OPENAI_API_KEY=sk-...
# Optional organization-level billing for the admin Costs API. Use a separate Admin API key; do not reuse OPENAI_API_KEY.
# Keep this broad-scope key only in this backend environment. It is never sent to the browser.
# OPENAI_ADMIN_KEY=
# Optional USD estimates. Configure rates yourself; no rate is assumed.
# Example shape: {"openai:MODEL":{"input_per_million":"RATE","output_per_million":"RATE"},"elevenlabs:eleven_multilingual_v2":{"characters_per_million":"RATE"},"elevenlabs:scribe_v2":{"audio_per_minute":"RATE"}}
PROVIDER_PRICES_JSON={}
# Override only to point at an OpenAI-compatible endpoint (e.g. the test stub).
# OPENAI_BASE_URL=https://api.openai.com/v1

# Required. The app refuses to start a turn while any of these is SET_ME_IN_ENV.
LLM_ROUTER_MODEL=SET_ME_IN_ENV
LLM_TUTOR_MODEL=SET_ME_IN_ENV
LLM_QUIZ_MODEL=SET_ME_IN_ENV
LLM_SCORING_MODEL=SET_ME_IN_ENV
LLM_RECOMMENDATION_MODEL=SET_ME_IN_ENV
LLM_REFLECTION_MODEL=SET_ME_IN_ENV

# ----------- rag
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIM=1536
VECTOR_BACKEND=pgvector
QDRANT_URL=http://localhost:6333
QDRANT_COLLECTION=kodmod_curriculum_v2
QDRANT_TIMEOUT_SECONDS=5
# Optional CA bundle when the selected Qdrant endpoint uses a private TLS CA.
# QDRANT_CA_CERT_FILE=
# Optional for a secured remote Qdrant deployment; keep the key server-side.
# QDRANT_API_KEY=
RERANKER_MODEL=BAAI/bge-reranker-v2-m3
# Set to false to skip the local cross-encoder pass and use the embedding
# similarity order directly (no ~2GB model to load).
RAG_RERANK_ENABLED=true
RAG_TOP_K=8
RAG_RERANK_TOP_K=4

# ----------- uploads (teacher curriculum documents)
UPLOAD_DIR=./data/uploads
MAX_UPLOAD_MB=25

# ----------- voice
# Batch and WebSocket voice are optional. Keep provider keys on the API only;
# never expose them through NEXT_PUBLIC_* variables or browser bundles.
STT_BACKEND=elevenlabs
STT_MODEL=large-v3
STT_DEVICE=auto
STT_COMPUTE_TYPE=float16
STT_LANGUAGE=id
# DEEPGRAM_API_KEY=
TTS_BACKEND=elevenlabs
TTS_VOICE=id-ID-ArdiNeural
TTS_RATE=1.0
# Select `elevenlabs` for both TTS and STT, then fill these values.
# ELEVENLABS_API_KEY=
# Bian - Neutral, Calm and Clear
ELEVENLABS_TTS_VOICE_ID=1k39YpzqXZn52BgyLyGO
ELEVENLABS_TTS_MODEL=eleven_multilingual_v2
ELEVENLABS_TTS_OUTPUT_FORMAT=mp3_44100_128
ELEVENLABS_TTS_STABILITY=0.5
ELEVENLABS_TTS_SIMILARITY_BOOST=0.75
ELEVENLABS_TTS_STYLE=0.0
ELEVENLABS_TTS_SPEED=1.0
ELEVENLABS_TTS_SPEAKER_BOOST=false
ELEVENLABS_STT_MODEL=scribe_v2
ELEVENLABS_STT_NO_VERBATIM=true
ELEVENLABS_TIMEOUT_SECONDS=60

# ----------- observability
# LANGSMITH_API_KEY=
LANGSMITH_PROJECT=kodmod-ai
LANGCHAIN_TRACING_V2=false

# ----------- pedagogy
DEFAULT_DIFFICULTY=medium
DEFAULT_LANGUAGE=id
# Appended to every agent's system prompt so the LLM's spoken output stays in
# one consistent language, no matter what language the student writes in.
GRAPH_LANGUAGE="Bahasa Indonesia"
QUIZ_PASS_THRESHOLD=0.6
QUIZ_MAX_ATTEMPTS_PER_QUESTION=2
MASTERY_PROMOTION=0.8
SOCRATIC_DEPTH=3

# ----------- accessibility
ACCESSIBILITY_DEFAULT_PROFILE=blind
MAX_SPOKEN_SENTENCE_WORDS=22
