# Compose deployment settings. Provider secrets belong to apps/ai-engine/.env.
# Local Docker defaults do not require this file.
WEB_PORT=3100
API_PORT=8109
POSTGRES_PORT=5433
REDIS_PORT=6379
KODMOD_TAG=vps
# Use private for SSH-tunnel access until the domain and DNS are ready.
KODMOD_MODE=https

# Local Grafana is bound to loopback only. The VPS Compose file requires a unique password.
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=
GRAFANA_PORT=3001
MONITORING_DATA_ROOT=/srv/kodmod/data/monitoring
PROMETHEUS_RETENTION=30d
PROMETHEUS_RETENTION_SIZE=5GB

# Required for VPS Compose. Domain only, without https:// or a trailing slash.
APP_DOMAIN=
ACME_EMAIL=
DB_USER=kodmod
DB_NAME=kodmod
# Generate a unique hex secret; use the same password for an existing DB.
DB_PASSWORD=
# Production Redis authentication; generate a separate random hex secret.
REDIS_PASSWORD=

# Default uses cloud providers and embedding similarity, without local models.
INSTALL_RERANKER=false
RAG_RERANK_ENABLED=false
